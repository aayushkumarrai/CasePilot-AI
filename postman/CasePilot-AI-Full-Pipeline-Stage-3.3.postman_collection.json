        "url": "{{supabase_url}}/rest/v1/rpc/complete_analysis_run_with_outputs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"p_analysis_run_id\": \"{{analysis_run_uuid}}\",\n  \"p_case_summary\": \"Buyer Rao paid INR 500000, but possession remains disputed and no signed handover acknowledgment is in the uploaded material.\",\n  \"p_document_summaries\": [\n    {\n      \"ref\": \"document_summary_1\",\n      \"document_id\": \"{{document_uuid}}\",\n      \"summary\": \"The uploaded statement records payment, a claimed key handover, a possession dispute, and no signed handover acknowledgment.\"\n    }\n  ],\n  \"p_case_fields\": [\n    {\n      \"ref\": \"field_payment\",\n      \"field_key\": \"payment_amount\",\n      \"label\": \"Recorded payment\",\n      \"value\": \"INR 500000 paid on 10 June 2026.\"\n    }\n  ],\n  \"p_case_parties\": [\n    {\n      \"ref\": \"party_rao\",\n      \"name\": \"Rao\",\n      \"role\": \"Buyer\"\n    },\n    {\n      \"ref\": \"party_mehta\",\n      \"name\": \"Mehta\",\n      \"role\": \"Seller\"\n    }\n  ],\n  \"p_timeline_events\": [\n    {\n      \"ref\": \"timeline_payment\",\n      \"event_date_text\": \"10 June 2026\",\n      \"date_confidence\": \"exact\",\n      \"title\": \"Buyer payment recorded\",\n      \"description\": \"Buyer Rao paid INR 500000 on 10 June 2026.\"\n    }\n  ],\n  \"p_findings\": [\n    {\n      \"ref\": \"finding_possession_conflict\",\n      \"kind\": \"conflict\",\n      \"title\": \"Possession remains disputed\",\n      \"description\": \"Seller Mehta states keys were handed over on 12 June 2026, while Buyer Rao states possession remains disputed.\"\n    },\n    {\n      \"ref\": \"finding_handover_gap\",\n      \"kind\": \"gap\",\n      \"title\": \"Signed handover acknowledgment not found\",\n      \"description\": \"No signed handover acknowledgment is included in the uploaded material.\"\n    }\n  ],\n  \"p_tasks\": [\n    {\n      \"ref\": \"task_handover_acknowledgment\",\n      \"finding_ref\": \"finding_handover_gap\",\n      \"title\": \"Request signed handover acknowledgment\",\n      \"description\": \"Request the signed handover acknowledgment or confirm that it is not available.\"\n    }\n  ],\n  \"p_citations\": [\n    {\n      \"target_type\": \"case_summary\",\n      \"target_ref\": \"case_summary\",\n      \"passage_id\": \"{{passage_uuid}}\",\n      \"quote\": \"Buyer Rao paid INR 500000 on 10 June 2026.\"\n    },\n    {\n      \"target_type\": \"document_summary\",\n      \"target_ref\": \"document_summary_1\",\n      \"passage_id\": \"{{passage_uuid}}\",\n      \"quote\": \"Seller Mehta states keys were handed over on 12 June 2026.\"\n    },\n    {\n      \"target_type\": \"case_field\",\n      \"target_ref\": \"field_payment\",\n      \"passage_id\": \"{{passage_uuid}}\",\n      \"quote\": \"Buyer Rao paid INR 500000 on 10 June 2026.\"\n    },\n    {\n      \"target_type\": \"case_party\",\n      \"target_ref\": \"party_rao\",\n      \"passage_id\": \"{{passage_uuid}}\",\n      \"quote\": \"Buyer Rao\"\n    },\n    {\n      \"target_type\": \"case_party\",\n      \"target_ref\": \"party_mehta\",\n      \"passage_id\": \"{{passage_uuid}}\",\n      \"quote\": \"Seller Mehta\"\n    },\n    {\n      \"target_type\": \"timeline_event\",\n      \"target_ref\": \"timeline_payment\",\n      \"passage_id\": \"{{passage_uuid}}\",\n      \"quote\": \"Buyer Rao paid INR 500000 on 10 June 2026.\"\n    },\n    {\n      \"target_type\": \"finding\",\n      \"target_ref\": \"finding_possession_conflict\",\n      \"passage_id\": \"{{passage_uuid}}\",\n      \"quote\": \"Buyer Rao states possession remains disputed.\"\n    },\n    {\n      \"target_type\": \"finding\",\n      \"target_ref\": \"finding_handover_gap\",\n      \"passage_id\": \"{{passage_uuid}}\",\n      \"quote\": \"No signed handover acknowledgment is included in the uploaded material.\"\n    },\n    {\n      \"target_type\": \"task\",\n      \"target_ref\": \"task_handover_acknowledgment\",\n      \"passage_id\": \"{{passage_uuid}}\",\n      \"quote\": \"No signed handover acknowledgment is included in the uploaded material.\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('passage_uuid')) { throw new Error('Run request 15 first so passage_uuid is available.'); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
