{
  "info": {
    "name": "CasePilot AI \u2014 Full Pipeline Through Stage 3.3",
    "description": "One flat, ordered maintainer verification collection for every implemented API and internal lifecycle capability through Stage 3.3. Run requests 01\u201335 one at a time, in order. Request 14 may be repeated until extraction finishes. Request 20 is a visible grounded fixture representing output already validated by the backend-only Groq client and Stage 3.3 citation gate; it never exposes a Groq key. All values that can identify an environment, user, token, or signed object URL are read from the uncommitted local environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
