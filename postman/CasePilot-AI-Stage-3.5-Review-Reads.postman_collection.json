{
  "info": {"name": "CasePilot AI — Stage 3.5 Review Reads", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Run after a completed Stage 3.4 analysis. All review results come from FastAPI, never direct Supabase table reads."},
  "item": [
    {"name":"Supabase Sign In","request":{"method":"POST","header":[{"key":"apikey","value":"{{supabase_anon_key}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{supabase_url}}/auth/v1/token?grant_type=password","body":{"mode":"raw","raw":"{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"}},"event":[{"listen":"test","script":{"exec":["const body = pm.response.json();","pm.environment.set('access_token', body.access_token);","pm.test('Sign in succeeds', () => pm.response.to.have.status(200));"]}}]},
    {"name":"Overview","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{access_token}}"}],"url":"{{api_base_url}}/v1/cases/{{case_uuid}}/overview"},"event":[{"listen":"test","script":{"exec":["pm.test('Overview succeeds', () => pm.response.to.have.status(200));","const body = pm.response.json();","pm.test('Overview returns a case header', () => pm.expect(body.case.id).to.eql(pm.environment.get('case_uuid'));","pm.test('Completed fixture includes source-linked summary', () => { if (body.analysis_run) pm.expect(body.case_summary_citations.length).to.be.above(0); });"]}}]},
    {"name":"Timeline","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{access_token}}"}],"url":"{{api_base_url}}/v1/cases/{{case_uuid}}/timeline"},"event":[{"listen":"test","script":{"exec":["pm.test('Timeline succeeds', () => pm.response.to.have.status(200));","pm.test('Timeline is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"]}}]},
    {"name":"Issues","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{access_token}}"}],"url":"{{api_base_url}}/v1/cases/{{case_uuid}}/issues"},"event":[{"listen":"test","script":{"exec":["pm.test('Issues succeeds', () => pm.response.to.have.status(200));","const body = pm.response.json();","pm.test('Issue citations are resolved', () => { if (body.length) pm.expect(body[0].citations[0]).to.have.property('passage_id'); });"]}}]},
    {"name":"Tasks","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{access_token}}"}],"url":"{{api_base_url}}/v1/cases/{{case_uuid}}/tasks"},"event":[{"listen":"test","script":{"exec":["pm.test('Tasks succeeds', () => pm.response.to.have.status(200));","pm.test('Tasks is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"]}}]},
    {"name":"Activity","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{access_token}}"}],"url":"{{api_base_url}}/v1/cases/{{case_uuid}}/activity"},"event":[{"listen":"test","script":{"exec":["pm.test('Activity succeeds', () => pm.response.to.have.status(200));","pm.test('Activity is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"]}}]}
  ]
}
